#version 450
#include "mmvq_common.glsl"

const uint BYTES_PER_VALUE = 2;

// bf16 is the top half of an f32.
void load8(uint64_t address, out float v[8]) {
    const uvec4 a = ldw16(address);
    [[unroll]] for (uint i = 0; i < 4; i++) {
        v[2 * i] = uintBitsToFloat(a[i] << 16);
        v[2 * i + 1] = uintBitsToFloat(a[i] & 0xFFFF0000u);
    }
}

#include "mmvf.glsl"
