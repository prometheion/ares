#version 450
#include "sample_common.glsl"

// What drafts that stay on the device need besides the block that computes them: a draft chain's
// picks go straight into the records the next kernels read (the next link's token, the verify
// window's token, the list the host reads at the end of the step), and the hidden state a chain
// starts from is kept per sequence from step to step (`draft_rows`, `draft_shift`, `draft_keep`,
// `draft_commit`).
//
// One workgroup. The tokens of `n` picks: pick `c` goes to `next_tokens[c]` (for `c < n_next`;
// the token array of the next link's record), to `record_tokens[record_rows[c]]` (the step
// record's token of the row that verifies it) and to `drafts[draft_at[c]]` (what the host
// reads).
layout(local_size_x = 32) in;

layout(push_constant, std430) uniform Push {
    uint64_t picks;
    uint64_t next_tokens;
    uint64_t record_tokens;
    uint64_t record_rows;
    uint64_t drafts;
    uint64_t draft_at;
    uint n;
    uint n_next;
} pc;

void main() {
    for (uint c = gl_LocalInvocationID.x; c < pc.n; c += 32u) {
        const uint token = out_of(pc.picks, c).token;
        if (c < pc.n_next) {
            UintRef(pc.next_tokens + 4ul * c).v[0] = token;
        }
        UintRef(pc.record_tokens + 4ul * ldu(pc.record_rows + 4ul * c)).v[0] = token;
        UintRef(pc.drafts + 4ul * ldu(pc.draft_at + 4ul * c)).v[0] = token;
    }
}
