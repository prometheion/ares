#version 450
#include "sample_common.glsl"

// The best logits of each row, for the greedy pick, the reference point of every threshold (the
// best logit) and the candidates a grammar may fall back to: `sample_top` finds the best of each
// chunk of the vocabulary, `sample_top_merge` the best of a device's chunks, and when several
// devices each hold a slice of the vocabulary `sample_top_join` merges their lists after the
// devices exchanged them (as a sum: each device writes its own slot of the exchange buffer and
// zeros elsewhere).
//
// Grid (chunks, rows), 256 invocations. Chunk `b` of row `r` is the logits `b * chunk ..` of the
// row; its best candidates go to `lists[(r * chunks + b) * LIST ..]`, packed, best first, then a
// word that is 1 when the chunk has a logit that is NaN or plus infinity. `tokens` maps a
// column of the logits to its token (`tokens[first + i]`); null means the token is `first + i`.
layout(local_size_x = 256) in;

layout(push_constant, std430) uniform Push {
    uint64_t logits;
    uint stride;
    uint n_local;
    uint64_t tokens;
    uint first;
    uint chunk;
    uint64_t lists;
} pc;

shared uint64_t merged[CANDIDATES];
shared uint bad_any;

#include "sample_take_best.glsl"

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint r = gl_WorkGroupID.y;
    const uint begin = gl_WorkGroupID.x * pc.chunk;
    const uint end = min(begin + pc.chunk, pc.n_local);
    const uint64_t row = pc.logits + 4ul * r * pc.stride;
    if (tid == 0u) {
        bad_any = 0u;
    }
    barrier();

    uint64_t mine[CANDIDATES];
    [[unroll]] for (uint j = 0u; j < CANDIDATES; ++j) {
        mine[j] = 0ul;
    }
    uint n_mine = 0u;
    bool any_bad = false;
    for (uint i = begin + tid; i < end; i += THREADS) {
        bool bad;
        const float l = canonical_logit(ldf(row + 4ul * i), bad);
        any_bad = any_bad || bad;
        const uint token = pc.tokens != 0ul ? ldu(pc.tokens + 4ul * (pc.first + i)) : pc.first + i;
        uint64_t v = pack_pick(l, token);
        // Insert into the descending list; the smallest falls off the end.
        [[unroll]] for (uint j = 0u; j < CANDIDATES; ++j) {
            if (j < n_mine && v > mine[j]) {
                const uint64_t t = mine[j];
                mine[j] = v;
                v = t;
            }
        }
        if (n_mine < CANDIDATES) {
            [[unroll]] for (uint j = 0u; j < CANDIDATES; ++j) {
                if (j == n_mine) {
                    mine[j] = v;
                }
            }
            n_mine++;
        }
    }
    if (any_bad) {
        bad_any = 1u;
    }
    take_best(mine, n_mine);
    if (tid == 0u) {
        const uint64_t out_list = pc.lists + 8ul * (uint64_t(r) * gl_NumWorkGroups.x + gl_WorkGroupID.x) * LIST;
        [[unroll]] for (uint c = 0u; c < CANDIDATES; ++c) {
            U64Ref(out_list + 8ul * c).v[0] = merged[c];
        }
        U64Ref(out_list + 8ul * CANDIDATES).v[0] = uint64_t(bad_any);
    }
}
