#version 450
#include "sample_common.glsl"

// Grid (rows), 256 invocations. Reads the histogram of a level (summed over all devices) and
// takes the row one level down: the exact cut-offs of top-k and top-p are found from the top
// bits of the key down, in three levels of 11, 11 and 10 bits; the first value of a level's
// bits at which the running total reaches the target is the next part of the cut. Tokens tied
// at the cut are all kept: the cut is a threshold on the probability, not a number of tokens.
layout(local_size_x = 256) in;

layout(push_constant, std430) uniform Push {
    uint64_t exchange;
    uint64_t params;
    uint64_t state;
    uint descent;
    uint level;
} pc;

shared uint64_t counts[THREADS];
shared uint64_t weights[THREADS];

uint64_t bin_count(uint64_t bin) { return uint64_t(ldf(bin)); }
uint64_t bin_weight(uint64_t bin) {
    return uint64_t(ldf(bin + 4ul)) + (uint64_t(ldf(bin + 8ul)) << 20)
        + (uint64_t(ldf(bin + 12ul)) << 40);
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint r = gl_WorkGroupID.x;
    ParamsRef p = params_of(pc.params, r);
    const uint need = F_SAMPLE | (pc.descent == DESCENT_TOP_K ? F_TOP_K : F_TOP_P);
    if ((p.flags & need) != need) {
        return;
    }
    const uint bins = pc.level == 1u ? 2048u : 1024u;
    const uint per_thread = bins / THREADS;
    const uint64_t mine = pc.exchange + 4ul * (uint64_t(r) * BINS * BIN_WORDS + uint64_t(tid) * per_thread * BIN_WORDS);

    uint64_t c = 0ul, w = 0ul;
    for (uint j = 0u; j < per_thread; ++j) {
        c += bin_count(mine + 4ul * j * BIN_WORDS);
        w += bin_weight(mine + 4ul * j * BIN_WORDS);
    }
    counts[tid] = c;
    weights[tid] = w;
    // Running totals over the invocations, the invocation's own bins included.
    for (uint offset = 1u; offset < THREADS; offset <<= 1) {
        barrier();
        const uint64_t pc_ = tid >= offset ? counts[tid - offset] : 0ul;
        const uint64_t pw = tid >= offset ? weights[tid - offset] : 0ul;
        barrier();
        counts[tid] += pc_;
        weights[tid] += pw;
    }
    barrier();

    StateRef s = state_of(pc.state, r);
    const bool by_count = pc.descent == DESCENT_TOP_K;
    uint64_t target;
    if (by_count) {
        target = uint64_t(s.rem_k);
    } else if (pc.level == 0u) {
        // The share top_p of what top-k left, or of everything.
        const uint64_t z = (p.flags & F_TOP_K) != 0u ? s.z_k : weights[THREADS - 1u];
        const uint64_t lo = (z & 0xfffffffful) * uint64_t(p.top_p_q32);
        const uint64_t hi = (z >> 32) * uint64_t(p.top_p_q32);
        target = hi + (lo >> 32);
        target = target == 0ul ? 1ul : target;
    } else {
        target = s.rem_p;
    }
    const uint64_t total = by_count ? counts[tid] : weights[tid];
    const uint64_t before = tid != 0u ? (by_count ? counts[tid - 1u] : weights[tid - 1u]) : 0ul;
    const uint64_t w_before_mine = tid != 0u ? weights[tid - 1u] : 0ul;
    if (tid == THREADS - 1u && total < target) {
        // Fewer tokens than top-k asks for: no cut. A prefix no key has keeps the deeper levels
        // empty.
        if (by_count) {
            s.prefix_k = 0xffffffffu;
            s.rem_k = 0u;
            s.z_k += weights[tid];
        } else {
            s.prefix_p = 0xffffffffu;
            s.rem_p = 0ul;
        }
        return;
    }
    if (!(before < target && target <= total)) {
        return;
    }
    uint64_t run = before;
    uint64_t w_run = w_before_mine;
    uint bin = 0u;
    uint64_t w_bin = 0ul;
    for (uint j = 0u; j < per_thread; ++j) {
        const uint64_t b = mine + 4ul * j * BIN_WORDS;
        const uint64_t v = by_count ? bin_count(b) : bin_weight(b);
        w_bin = bin_weight(b);
        bin = tid * per_thread + j;
        if (run + v >= target) {
            break;
        }
        run += v;
        w_run += w_bin;
    }
    const uint shift = pc.level == 0u ? 0u : (pc.level == 1u ? 11u : 10u);
    const bool last = pc.level == 2u;
    if (by_count) {
        s.prefix_k = (s.prefix_k << shift) | bin;
        s.rem_k = uint(target - run);
        s.z_k += w_run + (last ? w_bin : 0ul);
        if (last) {
            s.cut_key = min(s.cut_key, s.prefix_k);
        }
    } else {
        s.prefix_p = (s.prefix_p << shift) | bin;
        s.rem_p = target - run;
        if (last) {
            s.cut_key = min(s.cut_key, s.prefix_p);
        }
    }
}
