#version 450
#define TOP_N 20u
#include "lp_take.glsl"

// The lists of all devices after the sum, merged: the row's candidates for its probabilities.
//
// Grid (rows), 32 invocations of which the first works.
layout(local_size_x = 32) in;

layout(push_constant, std430) uniform Push {
    uint64_t exchange;
    uint64_t params;
    uint64_t state;
    uint64_t logprobs;
    uint devices;
    uint raw;
} pc;

void main() {
    if (gl_LocalInvocationID.x != 0u) {
        return;
    }
    const uint r = gl_WorkGroupID.x;
    Params p = params_of(pc.params, r);
    State s = state_of(pc.state, r);
    if (!lp_row(p, s, pc.raw != 0u)) {
        return;
    }
    uint64_t best[LOGPROBS_MAX];
    uint bad;
    join_lists(pc.exchange, r, pc.devices, best, bad);
    lp_take(best, p, s, logprobs_of(pc.logprobs, r), pc.raw != 0u);
}
