#version 450
#include "sample_common.glsl"

// Grid (rows), 256 invocations, `chunks` at most that many: the best score of a row's chunks
// into its state.
layout(local_size_x = 256) in;

layout(push_constant, std430) uniform Push {
    uint64_t lists;
    uint64_t params;
    uint64_t state;
    uint chunks;
} pc;

void main() {
    const uint r = gl_WorkGroupID.x;
    if ((params_of(pc.params, r).flags & F_SAMPLE) == 0u) {
        return;
    }
    uint64_t best = 0ul;
    if (gl_LocalInvocationID.x < pc.chunks) {
        best = U64Ref(pc.lists + 8ul * (uint64_t(r) * pc.chunks + gl_LocalInvocationID.x)).v[0];
    }
    best = block_max_u64(best);
    if (gl_LocalInvocationID.x == 0u) {
        state_of(pc.state, r).best = best;
    }
}
