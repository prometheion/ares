#version 450
#include "sample_common.glsl"

// Grid (max_seg_rows, n_segs): keeps the final hidden state of the step's rows in the carries
// of their sequences.
layout(local_size_x = 256) in;

layout(push_constant, std430) uniform Push {
    uint64_t step;
    uint64_t hidden;
    uint64_t carry;
    uint carry_rows;
    uint d;
} pc;

void main() {
    const Seg seg = step_seg(pc.step, gl_WorkGroupID.y);
    const uint i = gl_WorkGroupID.x;
    if (i >= seg.n_rows) {
        return;
    }
    uint at;
    if ((seg.flags & SEG_DIRECT) != 0u) {
        if (i + 1u != seg.n_rows) {
            return;
        }
        at = 0u;
    } else {
        if (i >= pc.carry_rows) {
            return;
        }
        at = i;
    }
    const uint64_t from = pc.hidden + 4ul * uint64_t(seg.row0 + i) * pc.d;
    const uint64_t to = pc.carry + 4ul * (uint64_t(seg.slot) * pc.carry_rows + at) * pc.d;
    for (uint j = gl_LocalInvocationID.x; j < pc.d; j += 256u) {
        FloatRef(to + 4ul * j).v[0] = ldf(from + 4ul * j);
    }
}
