#version 450
#include "mmvq_common.glsl"

const uint BYTES_PER_VALUE = 4;

void load8(uint64_t address, out float v[8]) {
    const uvec4 a = ldw16(address);
    const uvec4 b = ldw16(address + 16);
    v[0] = uintBitsToFloat(a.x);
    v[1] = uintBitsToFloat(a.y);
    v[2] = uintBitsToFloat(a.z);
    v[3] = uintBitsToFloat(a.w);
    v[4] = uintBitsToFloat(b.x);
    v[5] = uintBitsToFloat(b.y);
    v[6] = uintBitsToFloat(b.z);
    v[7] = uintBitsToFloat(b.w);
}

#include "mmvf.glsl"
