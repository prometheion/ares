#version 450
#include "sample_common.glsl"

// Grid (rows), 32 invocations: the pick of a sampled row into its record.
layout(local_size_x = 32) in;

layout(push_constant, std430) uniform Push {
    uint64_t state;
    uint64_t exchange;
    uint64_t params;
    uint64_t out_;
    uint devices;
} pc;

void main() {
    if (gl_LocalInvocationID.x != 0u) {
        return;
    }
    const uint r = gl_WorkGroupID.x;
    if ((params_of(pc.params, r).flags & F_SAMPLE) == 0u) {
        return;
    }
    StateRef state = state_of(pc.state, r);
    OutRef out_ = out_of(pc.out_, r);
    uint64_t best = 0ul;
    if (pc.devices == 1u) {
        best = state.best;
    } else {
        const uint64_t slots = pc.exchange + 4ul * uint64_t(r) * pc.devices * PICK_VALUES;
        for (uint d = 0u; d < pc.devices; ++d) {
            const float token = ldf(slots + 4ul * (d * PICK_VALUES + 1u));
            if (token >= 0.0) {
                const uint64_t v = pack_pick(ldf(slots + 4ul * d * PICK_VALUES), uint(token));
                best = v > best ? v : best;
            }
        }
    }
    if (best == 0ul) {
        out_.token = 0xffffffffu;
        out_.status = state.status | S_EMPTY;
        return;
    }
    out_.token = 0xffffffffu - uint(best);
    out_.value = unsortable(uint(best >> 32));
    out_.status = state.status;
}
