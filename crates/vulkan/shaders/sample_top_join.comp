#version 450
#define TOP_N 8u
#include "sample_join.glsl"

// The lists of all devices, merged after the sum: finishes the row. Grid (rows), 32 invocations
// of which the first works.
layout(local_size_x = 32) in;

layout(push_constant, std430) uniform Push {
    uint64_t exchange;
    uint64_t params;
    uint64_t state;
    uint64_t out_;
    uint devices;
} pc;

void main() {
    if (gl_LocalInvocationID.x != 0u) {
        return;
    }
    const uint r = gl_WorkGroupID.x;
    uint64_t best[CANDIDATES];
    uint bad;
    join_lists(pc.exchange, r, pc.devices, best, bad);
    join_row(best, bad, params_of(pc.params, r), state_of(pc.state, r), out_of(pc.out_, r));
}
