#version 450
#include "sample_common.glsl"

// Builds the histogram of a device's slice of the vocabulary for one level of the radix descent
// of top-k or top-p. Grid (chunks, rows), 256 invocations. Adds the tokens of chunk
// `gl_WorkGroupID.x` of row `gl_WorkGroupID.y` to the row's histogram
// `hist[(r * BINS + bin) * BIN_WORDS ..]`, which must be zero before the first chunk adds to
// it.
layout(local_size_x = 256) in;

layout(push_constant, std430) uniform Push {
    uint64_t logits;
    uint stride;
    uint n_local;
    uint chunk;
    uint64_t params;
    uint64_t state;
    uint64_t hist;
    uint descent;
    uint level;
} pc;

shared uint local_hist[BINS * BIN_WORDS];

bool takes_part(uint flags, uint descent) {
    const uint need = F_SAMPLE | (descent == DESCENT_TOP_K ? F_TOP_K : F_TOP_P);
    return (flags & need) == need;
}

// The bins of a level: level 0 takes the top 11 bits of the key, which never exceed 1020 for a
// finite or infinite distance.
uint level_bins(uint level) { return level == 1u ? 2048u : 1024u; }

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint r = gl_WorkGroupID.y;
    if (!takes_part(params_of(pc.params, r).flags, pc.descent)) {
        return;
    }
    const uint bins = level_bins(pc.level);
    for (uint i = tid; i < bins * BIN_WORDS; i += THREADS) {
        local_hist[i] = 0u;
    }
    barrier();

    StateRef state = state_of(pc.state, r);
    const float l_max = state.l_max;
    const uint prefix = pc.descent == DESCENT_TOP_K ? state.prefix_k : state.prefix_p;
    const uint begin = gl_WorkGroupID.x * pc.chunk;
    const uint end = min(begin + pc.chunk, pc.n_local);
    const uint64_t row = pc.logits + 4ul * r * pc.stride;
    for (uint i = begin + tid; i < end; i += THREADS) {
        bool bad;
        const uint key = sample_key(l_max, canonical_logit(ldf(row + 4ul * i), bad));
        uint bin;
        if (pc.level == 0u) {
            bin = key >> 21;
        } else if (pc.level == 1u) {
            if ((key >> 21) != prefix) {
                continue;
            }
            bin = (key >> 10) & 0x7ffu;
        } else {
            if ((key >> 10) != prefix) {
                continue;
            }
            bin = key & 0x3ffu;
        }
        const uint64_t w = sample_weight(key);
        const uint at = bin * BIN_WORDS;
        atomicAdd(local_hist[at], 1u);
        if (w != 0ul) {
            atomicAdd(local_hist[at + 1u], uint(w & 0x3ffful));
            atomicAdd(local_hist[at + 2u], uint((w >> 14) & 0x3ffful));
            atomicAdd(local_hist[at + 3u], uint(w >> 28));
        }
    }
    barrier();
    const uint64_t global = pc.hist + 4ul * r * BINS * BIN_WORDS;
    for (uint i = tid; i < bins * BIN_WORDS; i += THREADS) {
        const uint v = local_hist[i];
        if (v != 0u) {
            atomicAdd(LWord(global + 4ul * i).v[0], v);
        }
    }
}
