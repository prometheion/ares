#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_control_flow_attributes : require

// Which element of a cooperative matrix of use A (f16, 16 x 16) each invocation holds, for
// the kernels over the device layouts (`mml_near.glsl`, `mml_wide.glsl`): they build the A operand from the codes
// of the weights in registers, in the order of an `mma` m16n8k16 A fragment:
//   element 4 r + 2 c + h of lane (g = lane / 4, t = lane % 4), r, c, h = 0 or 1, is the
//   matrix element in row g + 8 r, column 2 t + h + 8 c.
// (The registers of an `mma` A fragment hold the same elements in the order r, c: element
// pairs (g, 2t), (g + 8, 2t), (g, 2t + 8), (g + 8, 2t + 8). Vulkan on NVIDIA orders them
// (g, 2t), (g, 2t + 8), (g + 8, 2t), (g + 8, 2t + 8), as `vk_coop_layout` shows.)
// The specification leaves the order to the implementation, so the kernel sets the
// elements by that rule to row * 16 + column, multiplies by the identity and writes the
// product: the host checks that it is the matrix it meant. One subgroup.

layout(local_size_x = 32) in;

layout(push_constant, std430) uniform Push {
    uint64_t out_;
} pc;

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Out { float v[]; };

shared float16_t eye[256];
shared float result[256];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    for (uint i = lane; i < 256; i += 32) {
        eye[i] = (i / 16 == i % 16) ? 1.0hf : 0.0hf;
    }
    barrier();
    const uint g = lane / 4;
    const uint t = lane % 4;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a;
    [[unroll]] for (uint e = 0; e < 8; e++) {
        const uint row = g + 8 * ((e >> 2) & 1u);
        const uint col = 2 * t + (e & 1u) + 8 * ((e >> 1) & 1u);
        a[e] = float16_t(row * 16 + col);
    }
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
    coopMatLoad(b, eye, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    c = coopMatMulAdd(a, b, c);
    coopMatStore(c, result, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint i = lane; i < 256; i += 32) {
        Out(pc.out_).v[i] = result[i];
    }
}
