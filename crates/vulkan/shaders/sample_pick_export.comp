#version 450
#include "sample_pick.glsl"

// Several devices only: this device's best into its slot of `exchange` (PICK_VALUES values per
// device and row: the score, and the token or -1 for none), zeros into the other slots.
//
// Grid (rows), THREADS invocations.
layout(local_size_x = 256) in;

layout(push_constant, std430) uniform Push {
    uint64_t lists;
    uint64_t params;
    uint64_t state;
    uint64_t exchange;
    uint chunks;
    uint devices;
    uint rank;
} pc;

void main() {
    const uint r = gl_WorkGroupID.x;
    if ((params_of(pc.params, r).flags & F_SAMPLE) == 0u) {
        return;
    }
    const uint64_t best = pick_best(pc.lists, r, pc.chunks, state_of(pc.state, r));
    if (gl_LocalInvocationID.x != 0u) {
        return;
    }
    const uint64_t slots = pc.exchange + 4ul * uint64_t(r) * pc.devices * PICK_VALUES;
    for (uint d = 0u; d < pc.devices; ++d) {
        const bool mine = d == pc.rank;
        FloatRef(slots + 4ul * d * PICK_VALUES).v[0] =
            mine && best != 0ul ? unsortable(uint(best >> 32)) : 0.0;
        FloatRef(slots + 4ul * (d * PICK_VALUES + 1u)).v[0] =
            mine ? (best != 0ul ? float(0xffffffffu - uint(best)) : -1.0) : 0.0;
    }
}
