#version 450
#include "sample_common.glsl"

// The pick of a sampled row: among the tokens the cuts left, the one with the largest
// `logit / temperature + noise`, where the noise is the Gumbel number of (seed, position,
// token). That is a draw from the distribution of those tokens at that temperature, and because
// a token's noise depends on nothing else, the same row gives the same pick alone or in any
// batch, on one device or on several.
//
// Grid (chunks, rows), 256 invocations. Writes the best packed score of its chunk to
// `lists[r * chunks + chunk]` (CUDA raises a 64-bit maximum in the row's state with an atomic;
// 64-bit atomics are an optional feature here, and `sample_pick_merge` takes the maximum of
// the chunks).
layout(local_size_x = 256) in;

layout(push_constant, std430) uniform Push {
    uint64_t logits;
    uint stride;
    uint n_local;
    uint64_t tokens;
    uint first;
    uint chunk;
    uint64_t params;
    uint64_t state;
    uint64_t lists;
} pc;

void main() {
    const uint r = gl_WorkGroupID.y;
    ParamsRef p = params_of(pc.params, r);
    if ((p.flags & F_SAMPLE) == 0u) {
        return;
    }
    StateRef state = state_of(pc.state, r);
    const float l_max = state.l_max;
    const uint cut = state.cut_key;
    const uint begin = gl_WorkGroupID.x * pc.chunk;
    const uint end = min(begin + pc.chunk, pc.n_local);
    const uint64_t row = pc.logits + 4ul * r * pc.stride;
    uint64_t best = 0ul;
    for (uint i = begin + gl_LocalInvocationID.x; i < end; i += THREADS) {
        bool bad;
        const float l = canonical_logit(ldf(row + 4ul * i), bad);
        if (sample_key(l_max, l) > cut) {
            continue;
        }
        const uint token = pc.tokens != 0ul ? ldu(pc.tokens + 4ul * (pc.first + i)) : pc.first + i;
        const float g = sample_gumbel(p.seed_lo, p.seed_hi, p.position, token);
        precise float scaled = l * p.inv_temperature;
        precise float score = scaled + g;
        const uint64_t v = pack_pick(score, token);
        best = v > best ? v : best;
    }
    best = block_max_u64(best);
    if (gl_LocalInvocationID.x == 0u) {
        U64Ref(pc.lists + 8ul * (uint64_t(r) * gl_NumWorkGroups.x + gl_WorkGroupID.x)).v[0] = best;
    }
}
