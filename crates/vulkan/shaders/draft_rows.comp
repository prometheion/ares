#version 450
#include "sample_common.glsl"

// Grid (rows): `dst[r] = src[index[r]]`, rows of `d` values.
layout(local_size_x = 256) in;

layout(push_constant, std430) uniform Push {
    uint64_t dst;
    uint64_t src;
    uint64_t index;
    uint d;
} pc;

void main() {
    const uint64_t from = pc.src + 4ul * uint64_t(ldu(pc.index + 4ul * gl_WorkGroupID.x)) * pc.d;
    const uint64_t to = pc.dst + 4ul * uint64_t(gl_WorkGroupID.x) * pc.d;
    for (uint j = gl_LocalInvocationID.x; j < pc.d; j += 256u) {
        FloatRef(to + 4ul * j).v[0] = ldf(from + 4ul * j);
    }
}
